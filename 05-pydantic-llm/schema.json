{
  "$defs": {
    "LineItem": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "description": "product name, as in the supermarket catalog if possible",
          "title": "Product",
          "type": "string"
        },
        "quantity": {
          "description": "number of units in `unit`",
          "title": "Quantity",
          "type": "number"
        },
        "unit": {
          "description": "convert lb to kg, gallons to count",
