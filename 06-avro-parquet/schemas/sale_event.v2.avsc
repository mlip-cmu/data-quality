{
  "type": "record",
  "name": "SaleEvent",
  "namespace": "supermarket.pos",
  "doc": "One line on a receipt, sent by a checkout terminal",
  "fields": [
    {
      "name": "event_id",
      "type": "string"
    },
    {
      "name": "event_time",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "store_id",
      "type": "int"
    },
    {
      "name": "terminal_id",
      "type": "string"
    },
    {
      "name": "product_id",
      "type": "int"
    },
    {
      "name": "quantity",
      "type": "double"
    },
    {
      "name": "unit",
      "type": {
        "type": "enum",
        "name": "Unit",
        "symbols": [
          "count",
          "kg",
          "liter"
        ]
      }
    },
    {
      "name": "unit_price",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 8,
        "scale": 2
      }
    },
    {
      "name": "promo",
      "type": "boolean",
      "default": false
    },
    {
      "name": "loyalty_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Loyalty card, if the customer shows one"
    }
  ]
}